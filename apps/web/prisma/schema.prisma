generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  member
  coach
  admin
}

enum UserStatus {
  active
  inactive
}

enum UserTheme {
  system
  light
  dark
}

enum TariffConsumption {
  weekly_quota
  monthly_quota
  pack
}

enum TariffBilling {
  monthly
  quarterly
  semiannual
  annual
  none
  one_time
}

enum PaymentBilling {
  monthly
  quarterly
  semiannual
  annual
  one_time
}

enum ClassKind {
  directed
  open
}

enum InstanceStatus {
  scheduled
  cancelled
}

enum BookingPool {
  quota_directed
  quota_open
  pack
}

enum QuotaPeriod {
  week
  month
}

enum BookingStatus {
  active
  cancelled
}

enum EndedReason {
  change
  cancelled
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  loginId      String     @unique @map("login_id")
  passwordHash String     @map("password_hash")
  role         Role
  status       UserStatus
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  dni          String?
  phone        String?
  email        String?
  theme           UserTheme @default(system)
  paymentBoxId    String?   @map("payment_box_id") @db.Uuid
  preferenceBoxId String?   @map("preference_box_id") @db.Uuid
  failedLogins    Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime?  @map("locked_until") @db.Timestamptz
  tokenVersion Int        @default(0) @map("token_version")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  memberships              Membership[]
  creditGrantsReceived     CreditGrant[]     @relation("CreditGrantRecipient")
  creditGrantsCreated      CreditGrant[]     @relation("CreditGrantAuthor")
  paymentsReceived         Payment[]         @relation("PaymentMember")
  paymentsRecorded         Payment[]         @relation("PaymentAuthor")
  coachedTemplates         ClassTemplate[]
  coachedInstances         ClassInstance[]
  bookingsAsMember         Booking[]         @relation("BookingMember")
  bookingsCreated          Booking[]         @relation("BookingAuthor")
  bookingsCancelled        Booking[]         @relation("BookingCanceller")
  quotaAdjustmentsReceived QuotaAdjustment[] @relation("QuotaAdjustmentMember")
  quotaAdjustmentsCreated  QuotaAdjustment[] @relation("QuotaAdjustmentAuthor")
  profileImage             UserProfileImage?
  paymentBox               Box?              @relation("PaymentBox", fields: [paymentBoxId], references: [id])
  preferenceBox            Box?              @relation("PreferenceBox", fields: [preferenceBoxId], references: [id])

  @@index([paymentBoxId])
  @@map("user")
}

model Tariff {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  consumptionModel TariffConsumption @map("consumption_model")
  billingPeriod    TariffBilling     @map("billing_period")
  priceCents       Int               @map("price_cents")
  quotaDirected    Int?              @default(0) @map("quota_directed")
  quotaOpen        Int?              @default(0) @map("quota_open")
  packClasses      Int?              @map("pack_classes")
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  memberships      Membership[]

  @@map("tariff")
}

model Membership {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  tariffId    String       @map("tariff_id") @db.Uuid
  startedAt   DateTime     @map("started_at") @db.Timestamptz
  endedAt     DateTime?    @map("ended_at") @db.Timestamptz
  endedReason EndedReason? @map("ended_reason")
  user        User         @relation(fields: [userId], references: [id])
  tariff      Tariff       @relation(fields: [tariffId], references: [id])

  @@index([userId])
  /// Unique current membership: SQL index membership_one_current WHERE ended_at IS NULL
  @@map("membership")
}

model CreditGrant {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  quantity  Int
  paymentId String?  @map("payment_id") @db.Uuid
  note      String?
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation("CreditGrantRecipient", fields: [userId], references: [id])
  author    User     @relation("CreditGrantAuthor", fields: [createdBy], references: [id])
  payment   Payment? @relation(fields: [paymentId], references: [id])

  @@index([userId])
  @@map("credit_grant")
}

model QuotaAdjustment {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  period      QuotaPeriod
  periodStart DateTime    @map("period_start") @db.Date
  kind        ClassKind
  delta       Int
  note        String?
  createdBy   String      @map("created_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  user        User        @relation("QuotaAdjustmentMember", fields: [userId], references: [id])
  author      User        @relation("QuotaAdjustmentAuthor", fields: [createdBy], references: [id])

  @@index([userId, period, periodStart])
  @@map("quota_adjustment")
}

model Payment {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  paymentBoxId  String         @map("payment_box_id") @db.Uuid
  billingPeriod PaymentBilling @map("billing_period")
  periodStart   DateTime?      @map("period_start") @db.Date
  amountCents   Int            @map("amount_cents")
  method        String?
  recordedBy    String         @map("recorded_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  user          User           @relation("PaymentMember", fields: [userId], references: [id])
  paymentBox    Box            @relation(fields: [paymentBoxId], references: [id])
  recorder      User           @relation("PaymentAuthor", fields: [recordedBy], references: [id])
  creditGrants  CreditGrant[]

  @@index([userId, periodStart])
  @@index([paymentBoxId, createdAt(sort: Desc)])
  /// Unique subscription payment: SQL index payment_one_period
  @@map("payment")
}

model ClassType {
  slug      String          @unique
  id        String          @id @default(uuid()) @db.Uuid
  name      String
  kind      ClassKind
  imageKey  String?         @map("image_key")
  templates ClassTemplate[]
  instances ClassInstance[]
  trainings Training[]

  @@map("class_type")
}

model ClassTypeImage {
  id        String   @id
  mimeType  String   @map("mime_type")
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("class_type_image")
}

model UserProfileImage {
  userId    String   @id @map("user_id") @db.Uuid
  mimeType  String   @map("mime_type")
  data      Bytes
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile_image")
}

model Box {
  slug        String          @unique
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @unique
  weeklyHours Json            @map("weekly_hours") @db.JsonB
  exceptions  Json            @default("[]") @map("exceptions") @db.JsonB
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  templates         ClassTemplate[]
  instances         ClassInstance[]
  payingMembers     User[]          @relation("PaymentBox")
  preferringMembers User[]          @relation("PreferenceBox")
  payments          Payment[]

  @@map("box")
}

model ClassTemplate {
  id              String          @id @default(uuid()) @db.Uuid
  boxId           String          @map("box_id") @db.Uuid
  weekday         Int
  startTime       DateTime        @map("start_time") @db.Time(0)
  endTime         DateTime        @map("end_time") @db.Time(0)
  classTypeId     String          @map("class_type_id") @db.Uuid
  coachId         String?         @map("coach_id") @db.Uuid
  defaultCapacity Int             @map("default_capacity")
  active          Boolean         @default(true)
  box             Box             @relation(fields: [boxId], references: [id])
  classType       ClassType       @relation(fields: [classTypeId], references: [id])
  coach           User?           @relation(fields: [coachId], references: [id])
  instances       ClassInstance[]

  @@index([boxId])
  @@map("class_template")
}

model ClassInstance {
  id           String         @id @default(uuid()) @db.Uuid
  boxId        String         @map("box_id") @db.Uuid
  templateId   String?        @map("template_id") @db.Uuid
  date         DateTime       @db.Date
  startAt      DateTime       @map("start_at") @db.Timestamptz
  endAt        DateTime       @map("end_at") @db.Timestamptz
  classTypeId  String         @map("class_type_id") @db.Uuid
  kind         ClassKind
  coachId      String?        @map("coach_id") @db.Uuid
  capacity     Int
  status       InstanceStatus
  trainingId   String?        @map("training_id") @db.Uuid
  editedAt     DateTime?      @map("edited_at") @db.Timestamptz
  cancelReason String?        @map("cancel_reason")
  box          Box            @relation(fields: [boxId], references: [id])
  template     ClassTemplate? @relation(fields: [templateId], references: [id])
  classType    ClassType      @relation(fields: [classTypeId], references: [id])
  coach        User?          @relation(fields: [coachId], references: [id])
  training     Training?      @relation(fields: [trainingId], references: [id])
  bookings     Booking[]

  @@index([date])
  @@index([boxId])
  /// Unique template instance: SQL index class_instance_template_date WHERE template_id IS NOT NULL
  @@map("class_instance")
}

model Training {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  classTypeId String          @map("class_type_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  classType   ClassType       @relation(fields: [classTypeId], references: [id])
  phases      TrainingPhase[]
  instances   ClassInstance[]

  @@index([classTypeId])
  @@map("training")
}

model TrainingPhase {
  id         String          @id @default(uuid()) @db.Uuid
  trainingId String          @map("training_id") @db.Uuid
  name       String
  position   Int
  training   Training        @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  blocks     TrainingBlock[]

  @@index([trainingId])
  @@map("training_phase")
}

model TrainingBlock {
  id       String        @id @default(uuid()) @db.Uuid
  phaseId  String        @map("phase_id") @db.Uuid
  body     String
  position Int
  phase    TrainingPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId])
  @@map("training_block")
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  instanceId      String        @map("instance_id") @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  pool            BookingPool
  status          BookingStatus
  createdBy       String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz
  cancelledBy     String?       @map("cancelled_by") @db.Uuid
  quotaReturned   Boolean?      @map("quota_returned")
  instance        ClassInstance @relation(fields: [instanceId], references: [id])
  member          User          @relation("BookingMember", fields: [userId], references: [id])
  createdByUser   User          @relation("BookingAuthor", fields: [createdBy], references: [id])
  cancelledByUser User?         @relation("BookingCanceller", fields: [cancelledBy], references: [id])

  @@index([userId])
  @@index([instanceId])
  /// Unique active booking: SQL index booking_one_active WHERE status = 'active'
  @@map("booking")
}
